<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <PackageVersion>2.7.0</PackageVersion>
        <Version>2.7.0</Version>
        <AssemblyVersion>2.7.0.0</AssemblyVersion>
        <FileVersion>2.7.0.0</FileVersion>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
        <Copyright>Nor Gelera 2022</Copyright>
        <Owners>Nor Gelera</Owners>
        <Authors>Nor Gelera</Authors>
        <Product>POCO.Mapper</Product>
        <PackageReleaseNotes>View release on
            https://github.com/kuromukira/poco.mapper/releases/tag/v2.7.0</PackageReleaseNotes>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <Description>An alternative "Plain Old C# Objects" mapper with minimal configuration
            required.</Description>
        <PackageProjectUrl>https://kuromukira.github.io/poco.mapper/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/kuromukira/poco.mapper</RepositoryUrl>
        <PackageTags>poco mapper mapping entity class equals</PackageTags>
        <RepositoryType>Git</RepositoryType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DocumentationFile>..\POCOMapper\POCOMapper.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DocumentationFile>..\POCOMapper\POCOMapper.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="LICENSE" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>